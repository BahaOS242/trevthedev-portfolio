---
import '@fontsource/bowlby-one/latin-400.css';
import '@fontsource/archivo/latin-400.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/martian-mono/latin-400.css';
import '@fontsource/martian-mono/latin-700.css';
import FM from '../layouts/FM.astro';
import { SITE_URL, site, wa } from '../data/site';
import { AI_COST_MONTHLY } from '../lib/receptionist/roi';

const title = 'WhatsApp AI Receptionist for Bahamas Clinics | BahaOS';
const description =
  'BahaOS answers your WhatsApp 24/7 — books appointments, moves cancellations and hands tricky questions to staff. Built in Nassau. Try the live demo.';
const walkthrough = wa('Hi Trev, I want a walkthrough of the BahaOS WhatsApp AI receptionist');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'BahaOS WhatsApp AI Receptionist',
    serviceType: 'WhatsApp AI receptionist',
    description,
    url: `${SITE_URL}/whatsapp-ai-receptionist`,
    image: `${SITE_URL}/proof/whatsapp-ai-receptionist.webp`,
    provider: { '@id': `${SITE_URL}/#business` },
    areaServed: { '@type': 'Country', name: 'The Bahamas' },
    offers: {
      '@type': 'Offer',
      price: AI_COST_MONTHLY,
      priceCurrency: 'USD',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: AI_COST_MONTHLY, priceCurrency: 'USD', unitText: 'MONTH' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'WhatsApp AI Receptionist', item: `${SITE_URL}/whatsapp-ai-receptionist` },
    ],
  },
];

const tickerWords = ['Answered at 2:14am', 'Booked while you slept', 'Thursday cancel → refilled', 'No voicemail tag', 'Replies in seconds', 'Front desk gets the morning back'];

const jobs = [
  ['Answer', "Hours, prices, insurance and directions, straight from your clinic's own details.", '"Do you take NIB?" → plan list, 3 sec'],
  ['Qualify', "Spots who's ready to book and saves their name and number as a lead.", '"Haven\'t been in 2 yrs" → new patient'],
  ['Book', 'Service, day, time, name. It remembers what you already said and never asks twice.', '"Cleaning Fri 3pm" → 1 question left'],
  ['Follow up', 'Moves and cancels without fuss, then offers the open slot to the next patient.', '"Cancel Thursday" → slot reopened'],
  ['Escalate', 'Knows when to stop guessing and passes billing or clinical questions to a person.', '"About my bill" → front desk, flagged'],
];

const dials = [
  { title: 'Recover missed bookings', tag: 'Recover', rows: [
    ['rMissed', 'Messages that never got a reply, per month', 0, 120, 1, 20],
    ['rNew', 'Value of a new patient', 50, 1500, 10, 300],
    ['rRec', 'Share the AI turns into bookings', 0, 100, 5, 50],
  ] },
  { title: 'Keep patients coming back', tag: 'Retain', rows: [
    ['rActive', 'Active patients', 0, 3000, 50, 500],
    ['rLift', 'Retention lift from reminders and follow-ups', 0, 30, 1, 10],
    ['rRetVal', 'Yearly value of a returning patient', 100, 3000, 50, 800],
  ] },
  { title: 'Win back lapsed patients', tag: 'Reactivate', rows: [
    ['rInactive', 'Patients not seen in 18+ months', 0, 1500, 10, 100],
    ['rReact', 'Share who rebook after a WhatsApp nudge', 0, 60, 1, 20],
  ] },
] as const;
---
<FM title={title} description={description} jsonLd={jsonLd}>
<div class="rush">

<div class="ro-ticker" aria-hidden="true"><div class="ro-ticker-track">{[...tickerWords, ...tickerWords].map((w) => <span>{w}</span>)}</div></div>

<div class="ro-wrap">
  <nav class="ro-nav" aria-label="Main">
    <a class="ro-logo" href="#top"><span class="ro-logo-mark" aria-hidden="true"></span>BahaOS</a>
    <div class="ro-nav-links">
      <a href="#night">Night shift</a>
      <a href="#jobs">What it does</a>
      <a href="#numbers">Your numbers</a>
      <a href="/">← TrevTheDev</a>
      <a class="ro-btn ro-sm" href="#join">Get it for your practice</a>
    </div>
  </nav>
</div>

<main id="main">
<div class="ro-wrap">
  <header class="ro-hero" id="top">
    <div>
      <span class="ro-stamp">WhatsApp AI receptionist · built in Nassau</span>
      <h1>Lock up at five. <span class="ro-hl">Wake up</span> to a <span class="ro-aq">full book.</span></h1>
      <p class="ro-lede">BahaOS answers your clinic's WhatsApp all night. It books the 2am toothache, moves the Thursday cancel and fills the gap, so <strong>the day is lined up before you unlock the door.</strong></p>
      <div class="ro-cta-row">
        <a class="ro-btn" href="#night">Run a night shift ▸</a>
        <a class="ro-btn ro-alt" href="#numbers">What's it worth to me?</a>
      </div>
      <div class="ro-proof"><span>Replies in seconds, 24/7</span><span>Never re-asks</span><span>Hands off to staff</span></div>
    </div>

    <div class="ro-stage">
      <div class="ro-burst" aria-hidden="true"></div>
      <div class="ro-phone">
        <div class="ro-screen">
          <div class="ro-chat-top">
            <div class="ro-avatar" aria-hidden="true">BS</div>
            <div><b>BrightSmile Dental</b><small data-chat-state>online · answers 24/7</small></div>
            <span class="ro-live">Live demo</span>
          </div>
          <div class="ro-chat">
            <div class="k-msgs" role="log" aria-live="polite" aria-label="Demo conversation" data-msgs></div>
            <div class="k-chips" data-chips></div>
            <form class="k-form" autocomplete="off" data-form>
              <label class="sr-only" for="heroField">Message</label>
              <input class="k-field" id="heroField" placeholder="Type a message…" maxlength="500" data-field>
              <button class="k-send" type="submit" aria-label="Send" data-send>➤</button>
            </form>
          </div>
        </div>
      </div>
      <p class="ro-hint">Try it: "my tooth hurts" · "how much?" · "book a cleaning"</p>
    </div>
  </header>
</div>

<div class="ro-band" aria-hidden="true"></div>

<section class="ro-night" id="night" aria-labelledby="night-title">
  <div class="ro-wrap">
    <div class="ro-sec-head">
      <div>
        <p class="ro-kicker">Interactive model · one Tuesday</p>
        <h2 id="night-title">The desk closes. <em>The rush doesn't.</em></h2>
      </div>
      <p>Drag the needle or press play. These are sample messages a three-chair clinic gets in one day. Most of the bookable ones land when nobody is at the desk.</p>
    </div>

    <div class="ro-clock">
      <div class="ro-track" data-track>
        <div class="ro-open"><span>Desk staffed 8am–5pm</span></div>
        <div class="ro-needle" data-needle data-time="12:00am"></div>
      </div>
      <div class="ro-hours" aria-hidden="true"><span>12am</span><span>6am</span><span>12pm</span><span>6pm</span><span>12am</span></div>
      <div class="ro-controls">
        <button class="ro-btn ro-sm" type="button" data-play>▶ Play the day</button>
        <label class="sr-only" for="scrub">Time of day</label>
        <input type="range" id="scrub" min="0" max="24" step="0.05" value="24" data-scrub>
      </div>
      <div class="ro-legend">
        <span><i style="background:#00b8c4"></i>Booked</span>
        <span><i style="background:#ffc629"></i>Answered</span>
        <span><i style="background:#ffffff"></i>Rescheduled</span>
        <span><i style="background:#ff5c8a"></i>Sent to staff</span>
      </div>
    </div>

    <div class="ro-night-grid">
      <div class="ro-feed" aria-live="polite" data-feed></div>
      <div>
        <div class="ro-score">
          <div class="ro-tile ro-big"><b data-s="booked">$0</b><span>booked into the calendar</span></div>
          <div class="ro-tile"><b data-s="msgs">0</b><span>conversations handled</span></div>
          <div class="ro-tile ro-aqt"><b data-s="after">0</b><span>after hours</span></div>
          <div class="ro-tile"><b data-s="appts">0</b><span>appointments made</span></div>
          <div class="ro-tile ro-aqt"><b data-s="mins">0m</b><span>front-desk time saved</span></div>
        </div>
        <p class="ro-footnote">Sample day for illustration. Booked value uses first-visit prices. Time saved assumes 4 minutes of staff time per conversation.</p>
      </div>
    </div>
  </div>
</section>

<div class="ro-fringe" aria-hidden="true"></div>

<section id="jobs" aria-labelledby="jobs-title">
  <div class="ro-wrap">
    <div class="ro-sec-head">
      <div>
        <p class="ro-kicker">In order, every conversation</p>
        <h2 id="jobs-title">Five jobs. Zero missed beats.</h2>
      </div>
      <p>A patient message moves through these steps like a group moving down Bay Street. The receptionist keeps time so your staff don't have to.</p>
    </div>
    <ol class="ro-lineup">
      {jobs.map(([h, p, eg], i) => (
        <li class="ro-job"><span class="ro-n" aria-hidden="true">{i + 1}</span><h3>{h}</h3><p>{p}</p><p class="ro-eg">{eg}</p></li>
      ))}
    </ol>
  </div>
</section>

<div class="ro-band" aria-hidden="true"></div>

<section id="numbers" aria-labelledby="numbers-title">
  <div class="ro-wrap">
    <div class="ro-sec-head">
      <div>
        <p class="ro-kicker">Interactive model · your clinic</p>
        <h2 id="numbers-title">Score your year.</h2>
      </div>
      <p>Set the dials to match your clinic. The board adds up what recovered bookings, better retention and win-backs could be worth against the ${AI_COST_MONTHLY} a month plan.</p>
    </div>
    <div class="ro-roi">
      <div class="ro-dials">
        {dials.map((d) => (
          <fieldset class="ro-dial">
            <legend><h3>{d.title} <small>{d.tag}</small></h3></legend>
            {d.rows.map(([id, label, min, max, step, value]) => (
              <div class="ro-row">
                <label for={id}>{label}</label><output for={id} data-o={id}></output>
                <input type="range" id={id} min={min} max={max} step={step} value={value} data-dial>
              </div>
            ))}
          </fieldset>
        ))}
      </div>
      <aside class="ro-board" aria-live="polite" aria-label="Estimated yearly impact">
        <p class="ro-kicker" style="color: var(--ro-gold)">The judges' sheet</p>
        <div class="ro-lines">
          <div><span>Recovered bookings</span><b data-b="rec"></b></div>
          <div><span>Retained patients</span><b data-b="ret"></b></div>
          <div><span>Won-back patients</span><b data-b="react"></b></div>
          <div class="ro-cost"><span>BahaOS, 12 months</span><b data-b="cost"></b></div>
        </div>
        <div class="ro-multiple"><b data-b="mult"></b><span>back for every $1 spent</span></div>
        <div class="ro-net"><span data-b="net"></span><small>net yearly impact</small></div>
        <p class="ro-footnote">Planning model using your inputs, not a promise of results. Recover × 12 months; retain uses the lift you set; win-backs use the yearly patient value.</p>
      </aside>
    </div>
  </div>
</section>

<section class="ro-finale" id="join" aria-labelledby="join-title">
  <div class="ro-wrap ro-finale-inner">
    <div>
      <p class="ro-kicker" style="color: var(--ro-ink)">Rush out with us</p>
      <h2 id="join-title">Your front desk, on all night.</h2>
      <p>We connect BahaOS to your WhatsApp Business number and calendar, load your prices and policies, and your team keeps final say on anything sensitive.</p>
    </div>
    <div class="ro-price">
      <p class="ro-kicker" style="color: var(--ro-ink)">One plan</p>
      <p><b>${AI_COST_MONTHLY}</b> / month</p>
      <ul><li>Unlimited WhatsApp conversations</li><li>Calendar booking and reminders</li><li>Staff hand-off for anything tricky</li></ul>
      <a class="ro-btn" href={walkthrough} rel="noopener">Book a walkthrough ▸</a>
    </div>
  </div>
</section>
</main>

<footer class="ro-footer">
  <div class="ro-wrap">
    <span>BahaOS by <a href="/">{site.name}</a> · {site.city}, Bahamas · <a href="/engineering">Engineering profile</a></span>
    <span>BrightSmile Dental is a demo clinic. The chat runs the real receptionist engine, but nothing is booked or sent.</span>
  </div>
</footer>
</div>
</FM>

<script>
  import type { ChatMessage, SimulatedAction } from '../lib/receptionist/types';
  import { NIGHT_FEED, fmtHour, type NightOutcome } from '../lib/receptionist/night-feed';
  import { calculateRoi, AI_COST_ANNUAL } from '../lib/receptionist/roi';

  const q = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const money = (n: number) =>
    new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(Math.round(n || 0));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

  /* ---------------- live chat (real engine via /api/receptionist) ---------------- */
  const msgs = q('[data-msgs]');
  const chips = q('[data-chips]');
  const form = q<HTMLFormElement>('[data-form]');
  const field = q<HTMLInputElement>('[data-field]');
  const sendBtn = q<HTMLButtonElement>('[data-send]');
  const stateEl = q('[data-chat-state]');
  let history: ChatMessage[] = [];
  let busy = false;

  const stamp = (iso?: string) => {
    try { return new Date(iso ?? Date.now()).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); } catch { return ''; }
  };
  const scroll = () => { msgs.scrollTop = msgs.scrollHeight; };

  function bubble(text: string, who: 'in' | 'out', iso?: string) {
    const b = document.createElement('div');
    b.className = `k-msg k-${who}`;
    b.textContent = text;
    const ts = document.createElement('span');
    ts.className = 'k-ts';
    ts.textContent = stamp(iso) + (who === 'out' ? ' ✓✓' : '');
    b.appendChild(ts);
    msgs.appendChild(b);
    scroll();
  }

  const ACTION_LABELS: Record<SimulatedAction['type'], string> = {
    booking_captured: 'Booking request captured',
    reschedule_captured: 'Reschedule captured',
    cancellation_captured: 'Cancellation captured',
    escalation_created: 'Sent to front desk',
    lead_captured: 'Lead captured',
  };
  const labelize = (k: string) => k.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, (c) => c.toUpperCase());

  function ticket(action: SimulatedAction) {
    const t = document.createElement('div');
    t.className = `k-ticket${action.type === 'escalation_created' ? ' k-esc' : ''}`;
    const h = document.createElement('strong');
    h.textContent = `✓ ${ACTION_LABELS[action.type]}`;
    t.appendChild(h);
    for (const [k, v] of Object.entries(action.details ?? {})) {
      const row = document.createElement('span');
      row.textContent = `${labelize(k)}: ${v}`;
      t.appendChild(row);
    }
    const note = document.createElement('small');
    note.textContent = 'Demo only — nothing was actually booked or sent.';
    t.appendChild(note);
    msgs.appendChild(t);
    scroll();
    if (action.type === 'booking_captured') stateEl.textContent = 'appointment booked ✓';
  }

  function setChips(list?: string[]) {
    chips.replaceChildren();
    for (const c of list ?? []) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'k-chip';
      b.textContent = c;
      b.addEventListener('click', () => send(c));
      chips.appendChild(b);
    }
  }

  let typing: HTMLElement | null = null;
  function showTyping() {
    if (typing) return;
    typing = document.createElement('div');
    typing.className = 'k-typing';
    typing.innerHTML = '<i></i><i></i><i></i>';
    msgs.appendChild(typing);
    scroll();
  }
  function hideTyping() { typing?.remove(); typing = null; }

  function setBusy(v: boolean) { busy = v; field.disabled = v; sendBtn.disabled = v; }

  async function call(payload: ChatMessage[]) {
    const res = await fetch('/api/receptionist', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ messages: payload }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data?.error ?? 'Something went wrong.');
    return data.messages as ChatMessage[];
  }

  async function deliver(replies: ChatMessage[]) {
    for (let i = 0; i < replies.length; i++) {
      const m = replies[i];
      await sleep(450 + Math.min((m.text?.length ?? 0) * 9, 700));
      hideTyping();
      if (m.action && m.action.type !== 'lead_captured') ticket(m.action);
      else if (m.text) bubble(m.text, 'out', m.timestamp);
      history.push(m);
      if (i < replies.length - 1) showTyping();
    }
    setChips(replies[replies.length - 1]?.quickReplies);
  }

  async function send(text: string) {
    text = text.trim();
    if (busy || !text) return;
    setBusy(true);
    setChips([]);
    const mine: ChatMessage = { id: crypto.randomUUID(), role: 'customer', text, timestamp: new Date().toISOString() };
    bubble(text, 'in', mine.timestamp);
    history.push(mine);
    showTyping();
    try {
      await deliver(await call(history));
    } catch (err) {
      hideTyping();
      history.pop();
      const e = document.createElement('div');
      e.className = 'k-err';
      e.textContent = err instanceof Error ? err.message : 'Something went wrong.';
      msgs.appendChild(e);
      scroll();
    } finally {
      setBusy(false);
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = field.value;
    field.value = '';
    send(v);
  });

  (async () => {
    setBusy(true);
    showTyping();
    try { await deliver(await call([])); }
    catch { hideTyping(); bubble("Hi! 👋 I'm the BrightSmile Dental assistant. Ask me to book, share prices or answer questions.", 'out'); }
    finally { setBusy(false); }
  })();

  /* ---------------- night shift model ---------------- */
  const track = q('[data-track]');
  const needle = q('[data-needle]');
  const scrub = q<HTMLInputElement>('[data-scrub]');
  const feed = q('[data-feed]');
  const play = q<HTMLButtonElement>('[data-play]');
  const isAfter = (t: number) => t < 8 || t >= 17;
  const LABEL: Record<NightOutcome, string> = { booked: 'Booked', answered: 'Answered', moved: 'Rescheduled', escalated: 'Sent to staff' };
  const pins = NIGHT_FEED.map((m) => {
    const p = document.createElement('span');
    p.className = `ro-pin ${m.out}`;
    p.style.left = `${(m.t / 24) * 100}%`;
    p.title = `${fmtHour(m.t)} · ${m.name}`;
    track.appendChild(p);
    return p;
  });
  const S = (k: string) => q(`[data-s="${k}"]`);
  let shown = -1;

  function render(t: number) {
    needle.style.left = `${(t / 24) * 100}%`;
    needle.dataset.time = fmtHour(Math.min(t, 23.99));
    const upto = NIGHT_FEED.filter((m) => m.t <= t);
    pins.forEach((p, i) => p.classList.toggle('on', NIGHT_FEED[i].t <= t));
    if (upto.length === shown) return;
    shown = upto.length;
    feed.replaceChildren();
    if (!upto.length) {
      const empty = document.createElement('div');
      empty.className = 'ro-feed-empty';
      empty.textContent = '12:00am. Clinic is dark. Press play.';
      feed.appendChild(empty);
    }
    for (const m of [...upto].reverse()) {
      const c = document.createElement('article');
      c.className = `ro-card${isAfter(m.t) ? ' after' : ''}`;
      const time = document.createElement('time');
      time.textContent = fmtHour(m.t);
      const mid = document.createElement('div');
      const who = document.createElement('div');
      who.className = 'who';
      who.textContent = m.name + (isAfter(m.t) ? '  ·  after hours' : '');
      const said = document.createElement('div');
      said.className = 'said';
      said.textContent = `"${m.msg}"`;
      mid.append(who, said);
      const res = document.createElement('div');
      res.className = `res ${m.out}`;
      res.textContent = `${LABEL[m.out]} · ${m.what}`;
      c.append(time, mid, res);
      feed.appendChild(c);
    }
    const booked = upto.filter((m) => m.out === 'booked');
    S('booked').textContent = money(booked.reduce((a, m) => a + m.value, 0));
    S('msgs').textContent = String(upto.length);
    S('after').textContent = String(upto.filter((m) => isAfter(m.t)).length);
    S('appts').textContent = String(booked.length);
    const mins = upto.length * 4;
    S('mins').textContent = mins >= 60 ? `${Math.floor(mins / 60)}h ${mins % 60}m` : `${mins}m`;
  }

  let raf = 0;
  function stop() { cancelAnimationFrame(raf); raf = 0; play.textContent = '▶ Play the day'; }
  play.addEventListener('click', () => {
    if (raf) return stop();
    let t = +scrub.value >= 23.9 ? 0 : +scrub.value;
    let last = performance.now();
    play.textContent = '❚❚ Pause';
    const step = (now: number) => {
      t = Math.min(24, t + ((now - last) / 1000) * 1.6);
      last = now;
      scrub.value = String(t);
      render(t);
      if (t < 24) raf = requestAnimationFrame(step); else stop();
    };
    raf = requestAnimationFrame(step);
  });
  scrub.addEventListener('input', () => { stop(); render(+scrub.value); });
  track.addEventListener('click', (e) => {
    stop();
    const r = track.getBoundingClientRect();
    const t = Math.max(0, Math.min(24, ((e.clientX - r.left) / r.width) * 24));
    scrub.value = String(t);
    render(t);
  });
  render(24);

  /* ---------------- ROI scoreboard ---------------- */
  const val = (id: string) => +q<HTMLInputElement>(`#${id}`).value;
  const FMT: Record<string, (v: number) => string> = {
    rMissed: String, rNew: money, rRec: (v) => `${v}%`, rActive: (v) => v.toLocaleString(),
    rLift: (v) => `+${v} pts`, rRetVal: money, rInactive: (v) => v.toLocaleString(), rReact: (v) => `${v}%`,
  };
  const B = (k: string) => q(`[data-b="${k}"]`);
  function calc() {
    for (const id of Object.keys(FMT)) q(`[data-o="${id}"]`).textContent = FMT[id](val(id));
    const r = calculateRoi({
      missedBookingsPerMonth: val('rMissed'),
      avgRevenuePerNewCustomer: val('rNew'),
      recoveryRate: val('rRec') / 100,
      activeCustomers: val('rActive'),
      currentRetentionRate: 0,
      expectedRetentionRate: val('rLift') / 100,
      avgAnnualRevenuePerRetainedCustomer: val('rRetVal'),
      reactivationEnabled: true,
      inactiveCustomers: val('rInactive'),
      reactivationRate: val('rReact') / 100,
      revenuePerReactivatedCustomer: val('rRetVal'),
    });
    B('rec').textContent = money(r.recoveredAnnualRevenue);
    B('ret').textContent = money(r.retainedAnnualRevenue);
    B('react').textContent = money(r.reactivationAnnualRevenue);
    B('cost').textContent = `−${money(AI_COST_ANNUAL)}`;
    B('mult').textContent = `${Math.max(0, r.roiMultiple).toFixed(1)}×`;
