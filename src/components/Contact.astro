---
const email = "hello@trevthedev.com";
const socials = [
	{ label: "Email", href: `mailto:${email}` },
	{ label: "LinkedIn", href: "https://linkedin.com/in/trevthedev" },
	{ label: "GitHub", href: "https://github.com/trevthedev" },
	{ label: "X", href: "https://x.com/trevthedev" },
];
---

<section id="contact">
	<div id="contact-inner">
		<h2>Contact</h2>
		<h3 id="contact-heading">Let's work together</h3>
		<p>
			Have a project in mind or just want to say hi? I'm always open to
			hearing about new opportunities.
		</p>
		<a href={`mailto:${email}`} id="contact-cta">{email}</a>
		<div id="contact-socials">
			{socials.map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
		</div>
	</div>
	<footer>
		<p>&copy; {new Date().getFullYear()} Trevor Armstrong (TrevTheDev). All rights reserved.</p>
	</footer>
</section>

<style>
	#contact {
		padding: 100px 40px 40px;
		background: var(--surface);
		text-align: center;
	}

	#contact-inner {
		max-width: 560px;
		margin: 0 auto;
	}

	#contact h2 {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin: 0 0 16px;
	}

	#contact-heading {
		font-size: clamp(26px, 4vw, 38px);
		font-weight: 500;
		color: var(--ink);
		margin: 0 0 16px;
	}

	#contact p {
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink-soft);
		margin: 0 0 28px;
	}

	#contact-cta {
		display: inline-block;
		border-radius: 24px;
		padding: 13px 28px;
		font-size: 14px;
		font-weight: 500;
		background: var(--ink);
		color: #fff;
		text-decoration: none;
	}

	#contact-socials {
		display: flex;
		justify-content: center;
		gap: 24px;
		margin-top: 28px;
	}

	#contact-socials a {
		font-size: 14px;
		color: var(--ink-soft);
		text-decoration: none;
	}

	#contact-socials a:hover {
		color: var(--ink);
	}

	footer {
		margin-top: 80px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
	}

	footer p {
		font-size: 13px;
		color: var(--ink-soft);
		margin: 0;
	}

	@media (max-width: 640px) {
		#contact {
			padding: 64px 20px 32px;
		}
	}
</style>
