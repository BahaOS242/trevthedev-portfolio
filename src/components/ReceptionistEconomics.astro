<section id="recon">
	<div id="recon-inner">
		<p id="recon-kicker">Illustrative Customer Economics</p>
		<h2 id="recon-heading">What could this be worth to your business?</h2>
		<p id="recon-intro">
			Model the potential impact of recovering missed bookings, improving
			customer retention, and reactivating inactive customers.
		</p>
		<p id="recon-disclaimer">
			Planning assumptions only — not actual customer results.
		</p>

		<div id="recon-layout">
			<div id="recon-inputs">
				<div class="input-panel">
					<h3 class="input-panel-title">Recover missed bookings</h3>

					<div class="field">
						<label for="missedBookings">Missed booking opportunities / month</label>
						<input type="number" id="missedBookings" min="0" step="1" value="20" />
					</div>

					<div class="field">
						<label for="avgRevenuePerCustomer">Average revenue per new customer</label>
						<div class="field-prefix">
							<span>$</span>
							<input type="number" id="avgRevenuePerCustomer" min="0" step="1" value="300" />
						</div>
					</div>

					<div class="field slider-field">
						<label for="recoveryRate">
							Estimated recovery rate
							<output id="recoveryRateOut" for="recoveryRate">50%</output>
						</label>
						<input type="range" id="recoveryRate" min="0" max="100" step="5" value="50" />
					</div>
				</div>

				<div class="input-panel">
					<h3 class="input-panel-title">Retain more customers</h3>

					<div class="field">
						<label for="activeCustomers">Active customers</label>
						<input type="number" id="activeCustomers" min="0" step="1" value="500" />
					</div>

					<div class="field slider-field">
						<label for="currentRetention">
							Current annual retention rate
							<output id="currentRetentionOut" for="currentRetention">70%</output>
						</label>
						<input type="range" id="currentRetention" min="0" max="100" step="1" value="70" />
					</div>

					<div class="field slider-field">
						<label for="expectedRetention">
							Expected retention with AI follow-up
							<output id="expectedRetentionOut" for="expectedRetention">80%</output>
						</label>
						<input type="range" id="expectedRetention" min="0" max="100" step="1" value="80" />
						<p class="field-hint">
							A planning assumption you set — not a guaranteed result.
						</p>
					</div>

					<div class="field">
						<label for="avgRevenuePerRetained">Average annual revenue per retained customer</label>
						<div class="field-prefix">
							<span>$</span>
							<input type="number" id="avgRevenuePerRetained" min="0" step="1" value="800" />
						</div>
					</div>
				</div>

				<div class="input-panel">
					<div class="input-panel-header">
						<h3 class="input-panel-title">Reactivate inactive customers</h3>
						<label class="toggle">
							<input type="checkbox" id="reactivationEnabled" checked />
							<span class="toggle-track"><span class="toggle-thumb"></span></span>
							<span class="toggle-text">Include</span>
						</label>
					</div>

					<div id="reactivationFields">
						<div class="field">
							<label for="inactiveCustomers">Inactive customers</label>
							<input type="number" id="inactiveCustomers" min="0" step="1" value="100" />
						</div>

						<div class="field slider-field">
							<label for="reactivationRate">
								Expected reactivation rate
								<output id="reactivationRateOut" for="reactivationRate">20%</output>
							</label>
							<input type="range" id="reactivationRate" min="0" max="100" step="5" value="20" />
						</div>

						<div class="field">
							<label for="revenuePerReactivated">Revenue per reactivated customer</label>
							<div class="field-prefix">
								<span>$</span>
								<input type="number" id="revenuePerReactivated" min="0" step="1" value="800" />
							</div>
						</div>
					</div>
				</div>
			</div>

			<div id="recon-results">
				<div id="result-cards">
					<div class="result-card">
						<p class="result-eyebrow">Recover</p>
						<p class="result-sublabel">Potential annual revenue from missed bookings</p>
						<p class="result-value" id="outRecover">$36,000</p>
					</div>
					<div class="result-card">
						<p class="result-eyebrow">Retain</p>
						<p class="result-sublabel">
							Potential annual revenue protected/generated through improved retention
						</p>
						<p class="result-value" id="outRetain">$40,000</p>
					</div>
					<div class="result-card" id="reactivateCard">
						<p class="result-eyebrow">Reactivate</p>
						<p class="result-sublabel">Potential annual revenue from bringing inactive customers back</p>
						<p class="result-value" id="outReactivate">$16,000</p>
					</div>
				</div>

				<div id="result-totals">
					<div class="total-row">
						<span>Total potential annual impact</span>
						<strong id="outTotal">$92,000</strong>
					</div>
					<div class="total-row">
						<span>AI receptionist cost (annual)</span>
						<strong id="outAiCost">$3,600</strong>
					</div>
					<div class="total-row net-row">
						<span>Potential net annual impact</span>
						<strong id="outNet">$88,400</strong>
					</div>
				</div>

				<div id="roi-banner">
					<p id="roi-label">Potential ROI</p>
					<p id="roi-value">24.6&times;</p>
					<p id="roi-caption">for every $1 spent on the AI receptionist, per year</p>
				</div>
			</div>
		</div>

		<details id="how-calculated">
			<summary>How is this calculated?</summary>
			<div id="how-calculated-body">
				<div class="formula-block">
					<p class="formula-title">Recover</p>
					<p class="formula">
						Missed bookings/month &times; Recovery rate &times; Avg. revenue per new
						customer &times; 12
					</p>
				</div>
				<div class="formula-block">
					<p class="formula-title">Retain</p>
					<p class="formula">
						Active customers &times; (Expected retention &minus; Current retention)
						&times; Avg. annual revenue per retained customer
					</p>
				</div>
				<div class="formula-block">
					<p class="formula-title">Reactivate</p>
					<p class="formula">
						Inactive customers &times; Reactivation rate &times; Revenue per
						reactivated customer
					</p>
				</div>
				<div class="formula-block">
					<p class="formula-title">Net impact &amp; ROI</p>
					<p class="formula">
						Total impact &minus; ($300 &times; 12) = Net impact. Net impact &divide;
						$3,600 = ROI multiple.
					</p>
				</div>
				<p id="how-calculated-note">
					These are illustrative planning assumptions, not actual customer
					results. Actual outcomes depend on message volume, booking
					conversion, customer value, retention behavior, follow-up
					effectiveness, and the business's existing processes. Recover,
					Retain, and Reactivate are modeled as separate customer populations
					(new bookings, existing active customers, and lapsed customers) — if
					your real numbers overlap between categories, adjust the inputs so
					the same customer isn't counted twice.
				</p>
			</div>
		</details>
	</div>
</section>

<style>
	#recon {
		padding: 80px 40px;
		background: var(--bg-2);
	}

	#recon-inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	#recon-kicker {
		margin: 0 0 16px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	#recon-heading {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(26px, 4vw, 38px);
		color: var(--ink);
		margin: 0 0 16px;
		max-width: 640px;
	}

	#recon-intro {
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 560px;
		margin: 0 0 12px;
	}

	#recon-disclaimer {
		display: inline-block;
		font-size: 12px;
		font-weight: 600;
		color: var(--ink-soft);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 6px 14px;
		margin: 0 0 40px;
	}

	/* ---- Layout ---- */

	#recon-layout {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 24px;
		align-items: start;
	}

	#recon-inputs {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	#recon-results {
		display: flex;
		flex-direction: column;
		gap: 16px;
		position: sticky;
		top: 88px;
	}

	/* ---- Input panels ---- */

	.input-panel {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 22px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.input-panel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.input-panel-title {
		font-family: var(--font-serif);
		font-size: 16px;
		font-weight: 500;
		color: var(--ink);
		margin: 0;
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.field label {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		font-size: 13px;
		color: var(--ink-soft);
		gap: 8px;
	}

	.field label output {
		font-weight: 600;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.field input[type="number"] {
		font: inherit;
		font-size: 14px;
		padding: 10px 12px;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: var(--bg-1);
		color: var(--ink);
	}

	.field input[type="number"]:focus {
		outline: 2px solid var(--ink);
		outline-offset: 1px;
	}

	.field-prefix {
		display: flex;
		align-items: center;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: var(--bg-1);
		overflow: hidden;
	}

	.field-prefix span {
		padding: 0 0 0 12px;
		font-size: 14px;
		color: var(--ink-soft);
	}

	.field-prefix input {
		border: none !important;
		background: transparent !important;
		flex: 1;
		min-width: 0;
	}

	.field-hint {
		margin: 0;
		font-size: 11.5px;
		line-height: 1.4;
		color: var(--ink-soft);
	}

	input[type="range"] {
		appearance: none;
		-webkit-appearance: none;
		width: 100%;
		height: 4px;
		border-radius: 2px;
		background: var(--border);
		outline: none;
		margin: 2px 0;
	}

	input[type="range"]::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--ink);
		cursor: pointer;
		border: 2px solid var(--surface);
		box-shadow: 0 1px 3px rgba(26, 29, 46, 0.3);
	}

	input[type="range"]::-moz-range-thumb {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--ink);
		cursor: pointer;
		border: 2px solid var(--surface);
		box-shadow: 0 1px 3px rgba(26, 29, 46, 0.3);
	}

	/* ---- Toggle switch ---- */

	.toggle {
		display: flex;
		align-items: center;
		gap: 8px;
		cursor: pointer;
		font-size: 12px;
		font-weight: 600;
		color: var(--ink-soft);
	}

	.toggle input {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
	}

	.toggle-track {
		width: 34px;
		height: 20px;
		border-radius: 999px;
		background: var(--border);
		position: relative;
		flex-shrink: 0;
		transition: background 0.15s ease;
	}

	.toggle-thumb {
		position: absolute;
		top: 2px;
		left: 2px;
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: var(--surface);
		box-shadow: 0 1px 2px rgba(26, 29, 46, 0.3);
		transition: transform 0.15s ease;
	}

	.toggle input:checked + .toggle-track {
		background: var(--ink);
	}

	.toggle input:checked + .toggle-track .toggle-thumb {
		transform: translateX(14px);
	}

	.toggle input:focus-visible + .toggle-track {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}

	#reactivationFields {
		display: flex;
		flex-direction: column;
		gap: 16px;
		transition: opacity 0.15s ease;
	}

	#reactivationFields.is-disabled {
		opacity: 0.4;
		pointer-events: none;
	}

	/* ---- Result cards ---- */

	#result-cards {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.result-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 18px 20px;
		transition: opacity 0.15s ease;
	}

	.result-card.is-disabled {
		opacity: 0.4;
	}

	.result-eyebrow {
		margin: 0 0 6px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.result-sublabel {
		margin: 0 0 10px;
		font-size: 12px;
		line-height: 1.4;
		color: var(--ink-soft);
	}

	.result-value {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 26px;
		font-weight: 600;
		color: var(--ink);
	}

	/* ---- Totals ---- */

	#result-totals {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 18px 20px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.total-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		font-size: 13px;
		color: var(--ink-soft);
	}

	.total-row strong {
		font-size: 15px;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}

	.net-row {
		padding-top: 10px;
		border-top: 1px solid var(--border);
		font-weight: 600;
		color: var(--ink);
	}

	.net-row strong {
		font-size: 18px;
	}

	.net-row.is-negative strong {
		color: #a13b2c;
	}

	/* ---- ROI banner ---- */

	#roi-banner {
		background: var(--ink);
		color: #fff;
		border-radius: 16px;
		padding: 22px 24px;
		text-align: center;
	}

	#roi-label {
		margin: 0 0 6px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.65);
	}

	#roi-value {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 40px;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	#roi-value.is-negative {
		color: #ff9a85;
	}

	#roi-caption {
		margin: 6px 0 0;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.65);
	}

	/* ---- How is this calculated ---- */

	#how-calculated {
		margin-top: 32px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 14px;
		padding: 18px 22px;
	}

	#how-calculated summary {
		cursor: pointer;
		font-size: 14px;
		font-weight: 600;
		color: var(--ink);
	}

	#how-calculated-body {
		margin-top: 16px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.formula-title {
		margin: 0 0 4px;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.formula {
		margin: 0;
		font-size: 13px;
		line-height: 1.6;
		color: var(--ink);
		font-family: ui-monospace, "SF Mono", "Cascadia Code", monospace;
	}

	#how-calculated-note {
		margin: 6px 0 0;
		padding-top: 14px;
		border-top: 1px solid var(--border);
		font-size: 12.5px;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	@media (max-width: 900px) {
		#recon-layout {
			grid-template-columns: 1fr;
		}

		#recon-results {
			position: static;
		}
	}

	@media (max-width: 640px) {
		#recon {
			padding: 56px 20px;
		}

		.input-panel,
		#result-totals,
		#roi-banner,
		#how-calculated {
			padding: 18px;
		}
	}
</style>

<script>
	import { calculateRoi, AI_COST_ANNUAL, type RoiInputs } from "../lib/receptionist/roi";

	function $<T extends HTMLElement>(id: string): T {
		return document.getElementById(id) as T;
	}

	const numberFields = {
		missedBookingsPerMonth: $<HTMLInputElement>("missedBookings"),
		avgRevenuePerNewCustomer: $<HTMLInputElement>("avgRevenuePerCustomer"),
		activeCustomers: $<HTMLInputElement>("activeCustomers"),
		avgAnnualRevenuePerRetainedCustomer: $<HTMLInputElement>("avgRevenuePerRetained"),
		inactiveCustomers: $<HTMLInputElement>("inactiveCustomers"),
		revenuePerReactivatedCustomer: $<HTMLInputElement>("revenuePerReactivated"),
	} as const;

	const rateFields = {
		recoveryRate: $<HTMLInputElement>("recoveryRate"),
		currentRetentionRate: $<HTMLInputElement>("currentRetention"),
		expectedRetentionRate: $<HTMLInputElement>("expectedRetention"),
		reactivationRate: $<HTMLInputElement>("reactivationRate"),
	} as const;

	const rateOutputs: Record<keyof typeof rateFields, HTMLOutputElement> = {
		recoveryRate: $<HTMLOutputElement>("recoveryRateOut"),
		currentRetentionRate: $<HTMLOutputElement>("currentRetentionOut"),
		expectedRetentionRate: $<HTMLOutputElement>("expectedRetentionOut"),
		reactivationRate: $<HTMLOutputElement>("reactivationRateOut"),
	};

	const reactivationToggle = $<HTMLInputElement>("reactivationEnabled");
	const reactivationFields = $<HTMLDivElement>("reactivationFields");
	const reactivateCard = $<HTMLDivElement>("reactivateCard");
	const netRow = document.querySelector<HTMLDivElement>(".net-row")!;
	const roiValueEl = $<HTMLParagraphElement>("roi-value");

	const outRecover = $<HTMLParagraphElement>("outRecover");
	const outRetain = $<HTMLParagraphElement>("outRetain");
	const outReactivate = $<HTMLParagraphElement>("outReactivate");
	const outTotal = $<HTMLParagraphElement>("outTotal");
	const outAiCost = $<HTMLElement>("outAiCost");
	const outNet = $<HTMLElement>("outNet");

	const currencyFormatter = new Intl.NumberFormat("en-US", {
		style: "currency",
		currency: "USD",
		maximumFractionDigits: 0,
	});

	function formatCurrency(value: number): string {
		const rounded = Math.round(value);
		return (rounded < 0 ? "-" : "") + currencyFormatter.format(Math.abs(rounded));
	}

	function readInputs(): RoiInputs {
		return {
			missedBookingsPerMonth: numberFields.missedBookingsPerMonth.valueAsNumber || 0,
			avgRevenuePerNewCustomer: numberFields.avgRevenuePerNewCustomer.valueAsNumber || 0,
			recoveryRate: (rateFields.recoveryRate.valueAsNumber || 0) / 100,
			activeCustomers: numberFields.activeCustomers.valueAsNumber || 0,
			currentRetentionRate: (rateFields.currentRetentionRate.valueAsNumber || 0) / 100,
			expectedRetentionRate: (rateFields.expectedRetentionRate.valueAsNumber || 0) / 100,
			avgAnnualRevenuePerRetainedCustomer:
				numberFields.avgAnnualRevenuePerRetainedCustomer.valueAsNumber || 0,
			reactivationEnabled: reactivationToggle.checked,
			inactiveCustomers: numberFields.inactiveCustomers.valueAsNumber || 0,
			reactivationRate: (rateFields.reactivationRate.valueAsNumber || 0) / 100,
			revenuePerReactivatedCustomer: numberFields.revenuePerReactivatedCustomer.valueAsNumber || 0,
		};
	}

	function render() {
		const inputs = readInputs();
		const result = calculateRoi(inputs);

		outRecover.textContent = formatCurrency(result.recoveredAnnualRevenue);
		outRetain.textContent = formatCurrency(result.retainedAnnualRevenue);
		outReactivate.textContent = formatCurrency(result.reactivationAnnualRevenue);
		outTotal.textContent = formatCurrency(result.totalAnnualImpact);
		outAiCost.textContent = formatCurrency(AI_COST_ANNUAL);
		outNet.textContent = formatCurrency(result.netAnnualImpact);

		netRow.classList.toggle("is-negative", result.netAnnualImpact < 0);
		roiValueEl.textContent = `${result.roiMultiple.toFixed(1)}×`;
		roiValueEl.classList.toggle("is-negative", result.roiMultiple < 0);

		reactivateCard.classList.toggle("is-disabled", !inputs.reactivationEnabled);
		reactivationFields.classList.toggle("is-disabled", !inputs.reactivationEnabled);
	}

	for (const [key, el] of Object.entries(rateFields) as [keyof typeof rateFields, HTMLInputElement][]) {
		el.addEventListener("input", () => {
			rateOutputs[key].textContent = `${el.valueAsNumber}%`;
			render();
		});
	}

	for (const el of Object.values(numberFields)) {
		el.addEventListener("input", render);
	}

	reactivationToggle.addEventListener("change", render);

	render();
</script>
