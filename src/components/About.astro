---
const skillGroups = [
	{
		label: "Programming",
		items: [
			"Python",
			"TypeScript",
			"JavaScript",
			"Next.js",
			"HTML/CSS",
			"PostgreSQL",
			"Prisma",
			"Better Auth",
			"Git & GitHub",
			"APIs",
			"Software Testing",
		],
	},
	{
		label: "Web",
		items: [
			"Wix Studio",
			"Wix CMS",
			"Wix Headless",
			"Responsive Web Design",
			"Website Administration",
			"CMS Architecture",
			"Landing Pages",
			"Website Optimization",
		],
	},
	{
		label: "AI & Automation",
		items: [
			"ChatGPT",
			"Claude",
			"Claude Code",
			"Generative AI",
			"Prompt Engineering",
			"AI APIs",
			"AI Receptionists",
			"Workflow Automation",
			"AI Marketing Systems",
			"SaaS Development",
		],
	},
	{
		label: "Marketing & Design",
		items: [
			"SEO",
			"Local SEO",
			"Email Development",
			"Email Marketing",
			"Campaign Strategy",
			"Lead Generation",
			"Conversion Optimization",
			"Graphic Design",
			"Branding",
			"Digital Advertising Creative",
			"Social Media Graphics",
			"Flyer Design",
			"Canva",
			"Figma",
			"AI Image Generation",
		],
	},
	{
		label: "Business & Product",
		items: [
			"Product Development",
			"Market Research",
			"Pricing Strategy",
			"ROI Analysis",
			"Sales Strategy",
			"Competitive Analysis",
			"Business Automation",
		],
	},
];

const info = [
	{ label: "Location", value: "Nassau, Bahamas" },
	{ label: "Focus", value: "Software Eng. & Digital Growth" },
	{ label: "Availability", value: "Open for Projects" },
	{ label: "Studied", value: "Software Eng., BTVI · 2021–Present" },
];
---

<section id="about">
	<div id="about-inner">
		<h2>About</h2>
		<p>
			I'm Trevor Armstrong, known online as <strong>TrevTheDev</strong> — a
			software engineering student and technology-focused digital
			professional based in Nassau, Bahamas. I've studied Software
			Engineering at BTVI since 2021, and work hands-on across Python, web
			development, website administration, AI, graphic design, email
			development, SEO, and digital marketing.
		</p>
		<p>
			I build real-world digital solutions for businesses and develop
			independent technology projects — combining technical, creative, and
			business skills to turn ideas into practical digital products and
			customer experiences.
		</p>

		<div id="about-info-grid">
			{
				info.map((item) => (
					<div class="about-info-cell">
						<p class="about-info-label">{item.label}</p>
						<p class="about-info-value">{item.value}</p>
					</div>
				))
			}
		</div>

		<div id="about-skill-groups">
			{
				skillGroups.map((group) => (
					<div class="about-skill-group">
						<p class="about-skill-group-label">{group.label}</p>
						<ul class="about-skills">
							{group.items.map((skill) => <li>{skill}</li>)}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	#about {
		padding: 100px 40px;
		background: var(--surface);
	}

	#about-inner {
		max-width: 720px;
		margin: 0 auto;
	}

	#about h2 {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin: 0 0 24px;
	}

	#about p {
		font-size: 17px;
		line-height: 1.7;
		color: var(--ink);
		margin: 0 0 16px;
	}

	#about-info-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		border: 1px solid var(--border);
		border-radius: 12px;
		margin: 32px 0 0;
		overflow: hidden;
	}

	.about-info-cell {
		padding: 16px;
		border-left: 1px solid var(--border);
	}

	.about-info-cell:first-child {
		border-left: none;
	}

	.about-info-label {
		margin: 0 0 6px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.about-info-value {
		margin: 0;
		font-size: 14px;
		font-weight: 600;
		color: var(--ink);
	}

	#about-skill-groups {
		display: flex;
		flex-direction: column;
		gap: 22px;
		margin: 40px 0 0;
		padding-top: 32px;
		border-top: 1px solid var(--border);
	}

	.about-skill-group-label {
		margin: 0 0 12px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	.about-skills {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		padding: 0;
		margin: 0;
	}

	.about-skills li {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.02em;
		padding: 6px 12px;
		border-radius: 16px;
		background: var(--bg-2);
		color: var(--ink-soft);
	}

	@media (max-width: 640px) {
		#about {
			padding: 64px 20px;
		}

		#about-info-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.about-info-cell:nth-child(3) {
			border-left: none;
		}

		.about-info-cell {
			border-bottom: 1px solid var(--border);
		}

		.about-info-cell:nth-child(3),
		.about-info-cell:nth-child(4) {
			border-bottom: none;
		}
	}
</style>
