<script>
	import type { Check, AuditResult, CategoryResult, Severity } from "../lib/audit-engine";
	import { getPlainEnglish } from "../lib/plain-english";

	const WHATSAPP_NUMBER = "12428012847";

	const form = document.getElementById("auditor-form") as HTMLFormElement;
	const submitBtn = document.getElementById("auditor-submit") as HTMLButtonElement;
	const errorEl = document.getElementById("auditor-error") as HTMLParagraphElement;
	const loadingEl = document.getElementById("auditor-loading") as HTMLDivElement;
	const resultsEl = document.getElementById("auditor-results") as HTMLDivElement;

	const scoreRing = document.getElementById("growth-score-ring") as HTMLDivElement;
	const scoreNumber = document.getElementById("growth-score-number") as HTMLSpanElement;
	const opportunitiesCountEl = document.getElementById("growth-opportunities-count") as HTMLParagraphElement;

	const categoryGrid = document.getElementById("category-grid") as HTMLDivElement;
	const methodologyWeights = document.getElementById("methodology-weights") as HTMLUListElement;

	const problemCard1 = document.getElementById("problem-card-1") as HTMLDivElement;
	const problemCard2 = document.getElementById("problem-card-2") as HTMLDivElement;

	const paywallBlurredList = document.getElementById("paywall-blurred-list") as HTMLDivElement;
	const paywallCopy = document.getElementById("paywall-copy") as HTMLParagraphElement;
	const paywallUnlockBtn = document.getElementById("paywall-unlock-btn") as HTMLAnchorElement;

	// Small safe-DOM helper — every dynamic string (site titles, meta descriptions,
	// etc. scraped from a third-party site) goes through `text`, never innerHTML,
	// so audited-site content can never execute as markup in the visitor's browser.
	function el<K extends keyof HTMLElementTagNameMap>(
		tag: K,
		opts: { className?: string; text?: string; attrs?: Record<string, string> } = {},
		children: Node[] = [],
	): HTMLElementTagNameMap[K] {
		const node = document.createElement(tag);
		if (opts.className) node.className = opts.className;
		if (opts.text !== undefined) node.textContent = opts.text;
		if (opts.attrs) {
			for (const [key, value] of Object.entries(opts.attrs)) node.setAttribute(key, value);
		}
		for (const child of children) node.appendChild(child);
		return node;
	}

	interface FlatCheck {
		check: Check;
		categoryLabel: string;
	}

	const SEVERITY_RANK: Record<Severity, number> = { high: 0, medium: 1, low: 2 };

	function sortBySeverity(items: FlatCheck[]): FlatCheck[] {
		return [...items].sort(
			(a, b) => SEVERITY_RANK[a.check.severity] - SEVERITY_RANK[b.check.severity] || b.check.maxPoints - a.check.maxPoints,
		);
	}

	// Same-origin 45-day window, computed fresh at click time so it's always
	// accurate regardless of when the page was loaded or deployed.
	function formatExpirationDate(): string {
		const expires = new Date();
		expires.setDate(expires.getDate() + 45);
		return expires.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
	}

	function buildWhatsAppUrl(message: string): string {
		return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
	}

	function renderProblemCard(
		container: HTMLDivElement,
		index: number,
		check: Check,
		siteUrl: string,
		leadEmail: string,
	) {
		const copy = getPlainEnglish(check);
		const priceLabel = copy.price != null ? `$${copy.price}` : "a custom quote";
		const buttonLabel = copy.price != null ? `Fix This on WhatsApp — $${copy.price} →` : "Fix This on WhatsApp →";

		const message = `Hi Trevor! I just ran the free BahaOS Growth Audit on ${siteUrl} (${leadEmail}) and found this: "${copy.title}". I'd like to fix it — I understand the cost is ${priceLabel}. Let's get started!`;

		const button = el("a", {
			className: "btn-whatsapp",
			text: buttonLabel,
			attrs: { href: buildWhatsAppUrl(message), target: "_blank", rel: "noopener noreferrer" },
		});

		container.replaceChildren(
			el("p", { className: "problem-eyebrow", text: `Opportunity #${index}` }),
			el("h3", { className: "problem-title", text: copy.title }),
			el("div", { className: "problem-block" }, [
				el("strong", { text: "What's happening" }),
				el("p", { text: copy.whatsHappening }),
			]),
			el("div", { className: "problem-block" }, [
				el("strong", { text: "Why it hurts you" }),
				el("p", { text: copy.whyItHurts }),
			]),
			el("div", { className: "problem-block" }, [
				el("strong", { text: "How Trev fixes it" }),
				el("p", { text: copy.howTrevFixes }),
			]),
			button,
		);
		container.hidden = false;
	}

	function renderResults(data: AuditResult, leadEmail: string) {
		// --- Score header ---
		scoreRing.style.setProperty("--score", String(data.score));
		scoreNumber.textContent = String(data.score);
		opportunitiesCountEl.textContent =
			data.opportunitiesCount === 0
				? "No major opportunities identified"
				: `${data.opportunitiesCount} opportunit${data.opportunitiesCount === 1 ? "y" : "ies"} identified`;

		// --- Category grid + methodology ---
		categoryGrid.replaceChildren();
		methodologyWeights.replaceChildren();
		for (const category of data.categories) {
			categoryGrid.appendChild(
				el("div", { className: "category-card" }, [
					el("p", { className: "category-label", text: category.label }),
					el("p", { className: "category-score" }, [
						document.createTextNode(String(category.score)),
						el("span", { text: "/100" }),
					]),
					el("div", { className: "category-bar" }, [
						(() => {
							const fill = el("div", { className: "category-bar-fill" });
							fill.style.width = `${category.score}%`;
							return fill;
						})(),
					]),
				]),
			);

			methodologyWeights.appendChild(
				el("li", {}, [
					document.createTextNode(category.label + " "),
					el("strong", { text: `${category.weight}%` }),
				]),
			);
		}

		// --- Flatten real, detected fails only (never the structural "unavailable" placeholders) ---
		const flatFails: FlatCheck[] = data.categories.flatMap((category: CategoryResult) =>
			category.checks
				.filter((check) => check.status === "fail")
				.map((check) => ({ check, categoryLabel: category.label })),
		);
		const sorted = sortBySeverity(flatFails);
		const [first, second, ...rest] = sorted;
		const siteUrl = data.url;

		// --- Two visible problem cards ---
		if (first) {
			renderProblemCard(problemCard1, 1, first.check, siteUrl, leadEmail);
		} else {
			problemCard1.hidden = true;
		}
		if (second) {
			renderProblemCard(problemCard2, 2, second.check, siteUrl, leadEmail);
		} else {
			problemCard2.hidden = true;
		}

		// --- Blurred paywall teaser + copy ---
		paywallBlurredList.replaceChildren();
		if (rest.length > 0) {
			paywallBlurredList.hidden = false;
			for (const { check, categoryLabel } of rest) {
				paywallBlurredList.appendChild(
					el("div", { className: "blurred-row" }, [
						el("span", { text: "\u{1F512}" }),
						el("span", { text: `${categoryLabel} — ${getPlainEnglish(check).title}` }),
					]),
				);
			}
			paywallCopy.textContent = `Your quick scan surfaced ${sorted.length} opportunities. You're seeing the top ${Math.min(2, sorted.length)} above — ${rest.length} more ${rest.length === 1 ? "is" : "are"} waiting in your full manual diagnostic, plus a local competitor authority scan against sites like BahamasLocal and The Tribune.`;
		} else {
			paywallBlurredList.hidden = true;
			paywallCopy.textContent =
				"Your automated quick scan is clean beyond what's shown above — nice work. The full manual diagnostic still catches things bots can't, including a local competitor authority scan against sites like BahamasLocal and The Tribune.";
		}

		const unlockMessage = `Hi Trevor! I just ran the free BahaOS Growth Audit on ${siteUrl} (${leadEmail}) — my Growth Score was ${data.score}/100 with ${data.opportunitiesCount} opportunities found. I'd like to unlock the full $99 Growth Diagnostic Report (including the local competitor authority scan). I understand that if I hire you to fix my site within 45 days (by ${formatExpirationDate()}), the $99 is credited toward my final bill.`;
		paywallUnlockBtn.setAttribute("href", buildWhatsAppUrl(unlockMessage));
	}

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		errorEl.textContent = "";
		resultsEl.hidden = true;

		const formData = new FormData(form);
		const name = String(formData.get("name") ?? "");
		const email = String(formData.get("email") ?? "");
		const url = String(formData.get("url") ?? "");

		submitBtn.disabled = true;
		loadingEl.hidden = false;

		try {
			const response = await fetch("/api/audit", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ name, email, url }),
			});

			const data = await response.json();

			if (!response.ok) {
				errorEl.textContent = data?.error ?? "Something went wrong. Please try again.";
				return;
			}

			renderResults(data as AuditResult, email);
			resultsEl.hidden = false;
			resultsEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
		} catch {
			errorEl.textContent = "Something went wrong. Please try again.";
		} finally {
			submitBtn.disabled = false;
			loadingEl.hidden = true;
		}
	});
</script>
