<section id="auditor">
	<div id="auditor-inner">
		<p id="auditor-kicker">Free Diagnostic</p>
		<h2 id="auditor-heading">Get your free BahaOS Growth Audit</h2>
		<p id="auditor-intro">
			I don't just check boxes for search engines — I look at where your
			digital customer journey has room to grow. Enter your site below for a
			free diagnostic across visibility, conversion, experience, trust, and
			technical health.
		</p>

		<form id="auditor-form">
			<div class="auditor-field">
				<label for="auditor-name">Name</label>
				<input id="auditor-name" name="name" type="text" placeholder="Jane Doe" required />
			</div>
			<div class="auditor-field">
				<label for="auditor-email">Email</label>
				<input id="auditor-email" name="email" type="email" placeholder="jane@business.com" required />
			</div>
			<div class="auditor-field">
				<label for="auditor-url">Website URL</label>
				<input id="auditor-url" name="url" type="text" placeholder="yourbusiness.com" required />
			</div>
			<button type="submit" id="auditor-submit">Run Free Growth Audit</button>
			<p id="auditor-error" role="alert"></p>
		</form>

		<div id="auditor-loading" hidden>
			<span class="spinner"></span>
			<span>Running your BahaOS Growth Audit&hellip; this can take up to 15 seconds.</span>
		</div>

		<div id="auditor-results" hidden>
			<!-- Score header -->
			<header id="growth-header">
				<p class="kicker">BahaOS Growth Score</p>
				<div id="growth-score-row">
					<div id="growth-score-ring">
						<div id="growth-score-number-wrap">
							<span id="growth-score-number">0</span><span id="growth-score-max">/100</span>
						</div>
					</div>
					<div>
						<p id="growth-opportunities-count"></p>
						<p id="growth-explanation">
							Your score is based on technical, content, conversion, experience,
							and visibility signals. It reflects what's publicly detectable on
							your site today — not a guarantee of business performance.
						</p>
					</div>
				</div>
			</header>

			<!-- Category scores -->
			<div id="category-grid"></div>

			<details id="methodology">
				<summary>How we calculate your score</summary>
				<p>
					Each category is scored 0–100 from its own set of checks, then
					combined using the weights below. Same site, same conditions, same
					score — nothing here is randomized.
				</p>
				<ul id="methodology-weights"></ul>
			</details>

			<!-- Top 2 visible problems -->
			<div id="problems-section">
				<p class="section-label">Your Top Opportunities</p>
				<div id="problem-card-1" class="problem-card" hidden></div>
				<div id="problem-card-2" class="problem-card" hidden></div>
			</div>

			<!-- Blurred paywall -->
			<div id="paywall-wrap">
				<div id="paywall-blurred-list" aria-hidden="true"></div>
				<div id="paywall-overlay">
					<p class="paywall-lock" aria-hidden="true">&#128274;</p>
					<h3 class="paywall-heading">Unlock Your Full Growth Diagnostic Report</h3>
					<p id="paywall-copy"></p>
					<a href="#" id="paywall-unlock-btn" class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
						Unlock Full Report — $99 &rarr;
					</a>
					<p class="paywall-discount">
						If you hire Trev to fix your website's leaks within the next 45
						days, the full $99 comes off your final bill — making this
						diagnostic 100% risk-free.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

