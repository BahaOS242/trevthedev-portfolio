---
const caseStudies = [
	{
		name: "Shipping OS",
		category: "Logistics SaaS",
		url: "https://shipping-os-kappa.vercel.app/demo",
		linkLabel: "Try the interactive demo",
		summary:
			"A modular, multi-tenant logistics platform for Bahamian freight forwarders, mailboat operators, couriers, warehouses and charter companies — one codebase, configured per business, with an interactive demo prospects can try in three minutes.",
		scope: [
			"Multi-tenant architecture with tenant isolation enforced in the service layer, backed by concurrent isolation tests",
			"Module registry and business-type presets that drive navigation, route guards and onboarding for each operator",
			"Bookings, vessel capacity, manifests, tracking, dispatch, proof of delivery, customer portal and WhatsApp updates",
			"An AI tool contract where every consequential write requires human confirmation and is audited",
			"A config-driven interactive demo with six scenarios, built with Next.js, TypeScript and Tailwind and deployed on Vercel",
		],
	},
	{
		name: "Fuel & Flow Pilates",
		category: "Booking & Scheduling",
		url: "https://www.fuelandflowbahamas.com/",
		summary:
			"A live studio site for a Pilates instructor in Nassau, Bahamas — class booking, event ticketing, membership plans, gift cards, and a members area, built and shipped on Wix.",
		scope: [
			"Wix Bookings for class scheduling and instructor calendar management",
			"Wix Events & Tickets for workshops and pop-up classes",
			"Wix Pricing Plans for recurring membership packages, plus Gift Cards",
			"A Members Area for returning clients",
			"Page titles and meta written around local search intent (\"Pilates Classes in Nassau, Bahamas\"), with sitemap and robots.txt configured for indexing",
		],
		linkLabel: "Visit the live site",
	},
];
---

<section id="case-studies">
	<div id="case-studies-inner">
		<p id="case-studies-kicker">Case Studies</p>
		<h2 id="case-studies-heading">Real products, live in production</h2>
		<p id="case-studies-intro">
			Not mockups — shipped software built for real Bahamian businesses.
		</p>

		<div id="case-studies-list">
			{caseStudies.map((caseStudy) => (
				<article class="case-card">
					<header class="case-card-header">
						<h3>{caseStudy.name}</h3>
						<span class="case-card-tag">{caseStudy.category}</span>
					</header>
					<p class="case-card-summary">{caseStudy.summary}</p>
					<ul class="case-card-scope">
						{caseStudy.scope.map((item) => <li>{item}</li>)}
					</ul>
					<a href={caseStudy.url} target="_blank" rel="noopener noreferrer" class="case-card-link">
						{caseStudy.linkLabel} &rarr;
					</a>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	#case-studies {
		padding: 100px 40px;
		background: var(--surface);
	}

	#case-studies-inner {
		max-width: 1040px;
		margin: 0 auto;
	}

	#case-studies-kicker {
		margin: 0 0 16px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	#case-studies-heading {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(28px, 4vw, 42px);
		letter-spacing: -0.02em;
		color: var(--ink);
		margin: 0 0 16px;
		max-width: 560px;
	}

	#case-studies-intro {
		font-size: 16px;
		line-height: 1.6;
		color: var(--ink-soft);
		max-width: 520px;
		margin: 0 0 48px;
	}

	#case-studies-list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
		align-items: start;
	}

	.case-card {
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 32px;
		background: var(--surface);
	}

	.case-card-header {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 8px 12px;
		margin-bottom: 14px;
	}

	.case-card-header h3 {
		font-size: 20px;
		font-weight: 600;
		color: var(--ink);
		margin: 0;
	}

	.case-card-tag {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		white-space: nowrap;
	}

	.case-card-summary {
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-soft);
		margin: 0 0 24px;
	}

	.case-card-scope {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin: 0 0 24px;
		padding: 18px 0 0;
		border-top: 1px solid var(--border);
		list-style: none;
	}

	.case-card-scope li {
		position: relative;
		padding-left: 20px;
		font-size: 13.5px;
		line-height: 1.55;
		color: var(--ink);
	}

	.case-card-scope li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 8px;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--ink-soft);
	}

	.case-card-link {
		display: inline-block;
		font-size: 14px;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--ink);
		padding-bottom: 2px;
	}

	@media (max-width: 780px) {
		#case-studies-list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		#case-studies {
			padding: 64px 20px;
		}

		.case-card {
			padding: 24px;
		}
	}
</style>
