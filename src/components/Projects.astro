---
import { items } from "@wix/data";

const COLLECTION_ID = "PortfolioProjects";

interface ProjectRecord {
	_id: string;
	title: string;
	description: string;
	githubUrl: string;
	demoUrl?: string;
	language?: string;
	tags?: string[];
	order?: number;
}

let projects: ProjectRecord[] = [];

try {
	const response = await items.query(COLLECTION_ID, {
		paging: { limit: 20, offset: 0 },
		sort: [{ fieldName: "order", order: "ASC" }],
	});
	projects = (response.items ?? []) as ProjectRecord[];
} catch (error) {
	console.error("Failed to load portfolio projects from CMS:", error);
}

function resolveHref(url: string | undefined): string | undefined {
	if (!url) return undefined;
	return url;
}
---

<section id="work">
	<div id="work-inner">
		<h2>Selected Work</h2>
		{
			projects.length === 0 ? (
				<p id="work-empty">Projects are managed in the CMS — add one to feature it here.</p>
			) : (
				<div id="work-grid">
					{projects.map((project) => (
						<article class="work-card">
							<div class="work-card-thumb" />
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							{project.tags && project.tags.length > 0 && (
								<div class="work-card-tags">
									{project.tags.map((tag) => <span>{tag}</span>)}
								</div>
							)}
							<div class="work-card-links">
								<a href={resolveHref(project.githubUrl)} target="_blank" rel="noopener noreferrer" class="work-card-link">
									View on GitHub &rarr;
								</a>
								{project.demoUrl && (
									<a href={resolveHref(project.demoUrl)} class="work-card-link work-card-link-secondary">
										Live Demo
									</a>
								)}
							</div>
						</article>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	#work {
		padding: 100px 40px;
		background: var(--bg-2);
	}

	#work-inner {
		max-width: 1040px;
		margin: 0 auto;
	}

	#work h2 {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin: 0 0 32px;
	}

	#work-empty {
		font-size: 14px;
		color: var(--ink-soft);
		margin: 0;
	}

	#work-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.work-card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 20px;
		transition: border-color 0.15s ease;
	}

	.work-card:hover {
		border-color: var(--ink);
	}

	.work-card-thumb {
		width: 100%;
		aspect-ratio: 16 / 10;
		border-radius: 10px;
		margin-bottom: 16px;
		background: linear-gradient(135deg, var(--bg-1) 0%, var(--bg-3) 100%);
	}

	.work-card h3 {
		font-size: 18px;
		font-weight: 600;
		color: var(--ink);
		margin: 0 0 8px;
	}

	.work-card p {
		font-size: 14px;
		line-height: 1.6;
		color: var(--ink-soft);
		margin: 0 0 14px;
	}

	.work-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}

	.work-card-tags span {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 4px 10px;
		border-radius: 12px;
		background: var(--bg-2);
		color: var(--ink-soft);
	}

	.work-card-links {
		margin-top: auto;
		display: flex;
		align-items: center;
		gap: 16px;
		padding-top: 8px;
	}

	.work-card-link {
		font-size: 13px;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}

	.work-card-link-secondary {
		color: var(--ink-soft);
		font-weight: 500;
	}

	.work-card-link:hover {
		text-decoration: underline;
	}

	@media (max-width: 780px) {
		#work-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		#work {
			padding: 64px 20px;
		}
	}
</style>
