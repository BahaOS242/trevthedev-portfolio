---
const projects = [
	{
		title: "WhatsApp AI Receptionist",
		description: "An AI-powered receptionist that handles customer conversations, captures leads, and helps businesses turn WhatsApp messages into appointments.",
		tags: ["Astro", "TypeScript", "Conversational AI"],
		href: "/whatsapp-ai-receptionist",
	},
	{
		title: "GrowthPulse Dashboard",
		description: "A real-time analytics dashboard for tracking marketing funnel metrics, built with React and a REST API backend.",
		tags: ["React", "REST API"],
	},
	{
		title: "StoreFront Boost",
		description: "A custom e-commerce backend integration that automates inventory syncing and growth reporting.",
		tags: ["PHP", "SQL"],
	},
	{
		title: "LeadGen Landing Kit",
		description: "A set of high-conversion landing page templates built for rapid A/B testing.",
		tags: ["HTML5", "CSS"],
	},
	{
		title: "AI Content Assistant",
		description: "An internal tool powered by Claude that drafts and optimizes marketing copy at scale.",
		tags: ["Claude", "REST API"],
	},
];
---

<section id="work">
	<div id="work-inner">
		<h2>Selected Work</h2>
		<div id="work-grid">
			{
				projects.map((project) => (
					<a href={project.href ?? "#"} class="work-card">
						<div class="work-card-thumb" />
						<h3>{project.title}</h3>
						<p>{project.description}</p>
						<div class="work-card-tags">
							{project.tags.map((tag) => <span>{tag}</span>)}
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	#work {
		padding: 100px 40px;
		background: var(--bg-2);
	}

	#work-inner {
		max-width: 1040px;
		margin: 0 auto;
	}

	#work h2 {
		font-size: 14px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin: 0 0 32px;
	}

	#work-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.work-card {
		display: block;
		text-decoration: none;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 20px;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.work-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 12px 24px rgba(26, 29, 46, 0.08);
	}

	.work-card-thumb {
		width: 100%;
		aspect-ratio: 16 / 10;
		border-radius: 10px;
		margin-bottom: 16px;
		background: linear-gradient(135deg, var(--bg-1) 0%, var(--bg-3) 100%);
	}

	.work-card h3 {
		font-size: 18px;
		font-weight: 600;
		color: var(--ink);
		margin: 0 0 8px;
	}

	.work-card p {
		font-size: 14px;
		line-height: 1.6;
		color: var(--ink-soft);
		margin: 0 0 14px;
	}

	.work-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.work-card-tags span {
		font-size: 12px;
		padding: 4px 10px;
		border-radius: 12px;
		background: var(--bg-2);
		color: var(--ink-soft);
	}

	@media (max-width: 780px) {
		#work-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		#work {
			padding: 64px 20px;
		}
	}
</style>
