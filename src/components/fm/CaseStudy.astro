---
import FM from '../../layouts/FM.astro';
import ThemeToggle from './ThemeToggle.astro';
import Footer from './Footer.astro';
import { SITE_URL, discoveryCall } from '../../data/site';

interface Props {
  slug: string;
  title: string;
  description: string;
  name: string;
  category: string;
  accent: string;
  headline: string;
  summary: string;
  liveUrl: string;
  liveLabel: string;
  journey: { heading: string; points: string[] };
  built: string[];
  stack: string[];
  related: { href: string; label: string }[];
}

const p = Astro.props;
const url = `${SITE_URL}/work/${p.slug}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `${p.name} — case study`,
    headline: p.headline,
    description: p.description,
    url,
    creator: { '@id': `${SITE_URL}/#trevor` },
    about: { '@type': 'WebSite', name: p.name, url: p.liveUrl },
    locationCreated: { '@type': 'Place', name: 'Nassau, The Bahamas' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${SITE_URL}/#proof` },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];
---
<FM title={p.title} description={p.description} jsonLd={jsonLd}>
<div class="wrap-narrow">
  <header class="site-header">
    <a href="/" class="logo" aria-label="TrevTheDev — home"><span style="background: var(--pink)">TREV</span>FM 242</a>
    <nav class="site-nav" aria-label="Main">
      <a href="/#web-development">Web development</a>
      <a href="/#proof">Work</a>
      <ThemeToggle />
    </nav>
  </header>

  <main id="main">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/#proof">Work</a> / <span aria-current="page">{p.name}</span>
    </nav>

    <section class="cs-hero" aria-labelledby="cs-title">
      <p class="tag mono box" style={`background: ${p.accent}`}>CASE STUDY · {p.category.toUpperCase()}</p>
      <h1 id="cs-title" class="display">{p.name}: <span style="color: var(--hl)">{p.headline}</span></h1>
      <p class="lede">{p.summary}</p>
      <div class="btns">
        <a href={p.liveUrl} rel="noopener" class="press btn box shadow bg-yellow">{p.liveLabel} ↗</a>
        <a href="/#web-development" class="press btn box shadow bg-surface">How I build websites</a>
      </div>
    </section>

    <section class="cs-grid" aria-label="Project details">
      <div class="box bg-surface cs-card">
        <h2 class="cs-h2">{p.journey.heading}</h2>
        <ul class="cs-list">{p.journey.points.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="box bg-surface cs-card">
        <h2 class="cs-h2">What I built</h2>
        <ul class="cs-list">{p.built.map((x) => <li>{x}</li>)}</ul>
      </div>
    </section>

    <section class="cs-stack" aria-labelledby="cs-stack-title">
      <h2 id="cs-stack-title" class="mono">BUILT WITH</h2>
      <ul>{p.stack.map((s) => <li>{s}</li>)}</ul>
    </section>

    <section class="cs-related" aria-labelledby="cs-related-title">
      <h2 id="cs-related-title" class="cs-h2">Keep exploring</h2>
      <ul>{p.related.map((r) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
    </section>

    <section class="cs-cta box shadow-lg bg-pink" style="--sh: var(--yellow)" aria-labelledby="cs-cta-title">
      <h2 id="cs-cta-title" class="display">Want a website that works this hard?</h2>
      <div class="btns">
        <a href={discoveryCall} rel="noopener" class="btn btn-dark">Book a free discovery call ▶</a>
        <a href="/#audit" class="btn btn-white">Get a free Growth Audit</a>
      </div>
    </section>
  </main>
</div>
<Footer />
</FM>

<style>
  .crumbs { font-size: 13px; font-weight: 400; color: var(--subtle); padding: 8px 0 0; }
  .crumbs a { text-decoration: underline; }
  .cs-hero { padding: 32px 0 56px; display: flex; flex-direction: column; gap: 22px; }
  .tag { align-self: flex-start; color: var(--ink); padding: 8px 14px; font-size: 13px; }
  h1 { font-size: clamp(34px, 4.6vw, 64px); line-height: 1.04; letter-spacing: -0.03em; max-width: 1000px; }
  .lede { font-size: 20px; max-width: 760px; }
  .cs-grid { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); padding-bottom: 48px; }
  .cs-card { padding: 30px; display: flex; flex-direction: column; gap: 16px; }
  .cs-h2 { font-family: var(--display); font-weight: 900; font-size: 24px; line-height: 1.15; }
  .cs-list { padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .cs-list li { padding-left: 26px; position: relative; font-size: 16px; line-height: 1.55; color: var(--muted); }
  .cs-list li::before { content: ''; position: absolute; left: 0; top: 7px; width: 10px; height: 10px; background: var(--yellow); border: 2px solid var(--line); transform: rotate(45deg); }
  .cs-stack { padding-bottom: 48px; display: flex; flex-direction: column; gap: 14px; }
  .cs-stack h2 { font-size: 13px; color: var(--hl2); }
  .cs-stack ul, .cs-related ul { padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .cs-stack li { border: 2px solid var(--line); padding: 6px 10px; font-family: var(--mono); font-size: 13px; }
  .cs-related { padding-bottom: 56px; display: flex; flex-direction: column; gap: 16px; }
  .cs-related a { display: block; border: 3px solid var(--line); padding: 14px 16px; font-weight: 700; }
  .cs-related a::after { content: ' →'; color: var(--hl); }
  .cs-related a:hover { background: var(--surface); }
  .cs-cta { padding: 40px; margin-bottom: 72px; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .cs-cta h2 { font-size: clamp(24px, 3vw, 38px); line-height: 1.08; flex: 1 1 400px; }
  @media (max-width: 600px) { .cs-card, .cs-cta { padding: 22px; } }
</style>
